{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --import ./scripts/sanitize-runtime-db-env.mjs --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/security.test.ts src/connector-utils.test.ts src/ai-security.test.ts src/lib/ai-assessment-qwen-evidence.test.ts src/lib/ai-assessment-sandbox.test.ts src/lib/assessment-container-control.test.ts src/lib/assessment-output-limit.test.ts src/middlewares/ai-assessment-json.test.ts",
    "test:assessment-container-integration": "NODE_ENV=development tsx --test src/lib/assessment-container-hardening.integration.test.ts",
    "test:ai-assessment-e2e": "NODE_ENV=development tsx --test src/ai-assessment-e2e.test.ts && NODE_ENV=development tsx --tsconfig ../eu-security-platform/tsconfig.json --test ../eu-security-platform/src/components/AiEvaluationPage.integration.test.tsx"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1159.0",
    "@aws-sdk/credential-providers": "^3.1159.0",
    "@clerk/express": "^2.1.84",
    "@clerk/shared": "^4.42.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
