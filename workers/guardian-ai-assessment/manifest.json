{
  "module": "Guardian AI Security Assessment",
  "moduleLabelEs": "Evaluación de Seguridad de IA",
  "workerVersion": "guardian-ai-assessment-lab-0.3.0",
  "imagePlatform": "linux/amd64",
  "baseImage": "python:3.13-slim-trixie",
  "baseImageDigest": "sha256:2d44738ebf4ce5f63b9d9ea871e9c7cfdc0426f7b0c97cac915fd88ded1d86bb",
  "python": "3.13",
  "engine": {
    "name": "garak",
    "version": "0.17.1",
    "license": "Apache-2.0",
    "source": "https://github.com/NVIDIA/garak",
    "commercialBranding": false
  },
  "target": {
    "profile": "guardian-local-agent-v1",
    "scope": "owned synthetic loopback laboratory only",
    "publicEndpointsAllowed": false,
    "customerDataAllowed": false,
    "paidModelsAllowed": false
  },
  "limits": {
    "maxRuntimeSeconds": 120,
    "cpuCores": 0.5,
    "memoryMiB": 768,
    "pids": 64,
    "concurrency": 1,
    "probeClasses": 1,
    "probeRequests": 1,
    "generationsPerProbe": 1,
    "tmpfsMiB": 64
  },
  "validationSuite": {
    "mode": "fixed-local-only",
    "seed": 20261030,
    "probeClasses": [
      "probes.promptinject.HijackLongPrompt",
      "probes.promptinject.HijackHateHumans"
    ],
    "profiles": [
      "vulnerable_echo",
      "safe_refusal",
      "safe_quoted_refusal",
      "vulnerable_base64"
    ],
    "sampleCount": 8,
    "metricTask": "synthetic-canary-propagation-only",
    "attackExecutionMeasurable": false,
    "legacyMixedProfileMatrixInvalid": true,
    "maxRuntimeSeconds": 240,
    "concurrency": 1,
    "rawPromptsStored": false,
    "rawResponsesStored": false
  },
  "detectorCorpus": {
    "schemaVersion": "guardian-ai-detector-corpus-v1",
    "sampleCount": 128,
    "datasets": [
      {
        "id": "attack_success",
        "samplesPerSplit": 32,
        "positiveSupportPerSplit": 16,
        "negativeSupportPerSplit": 16
      },
      {
        "id": "canary_propagation",
        "samplesPerSplit": 32,
        "positiveSupportPerSplit": 16,
        "negativeSupportPerSplit": 16
      }
    ],
    "splits": ["calibration", "holdout"],
    "languages": ["en", "es"],
    "target": "synthetic deterministic local response fixtures",
    "execution": "direct Garak detector API; no full CLI run or LLM inference",
    "syntheticPromptsAndResponsesStored": true,
    "customerDataAllowed": false
  },
  "optionalDetectors": [
    {
      "id": "meta-llama/Llama-Prompt-Guard-2-22M",
      "status": "design-only-not-installed",
      "license": "Llama 4 Community License; gated model access",
      "runtimeNetworkRequired": false,
      "modelArtifactsPresent": false,
      "adapterContract": "documented-offline-local-model-artifact-and-hash-required"
    }
  ],
  "network": {
    "runtimeMode": "docker-network-none",
    "egressPolicyOwner": "container runtime / external network controller",
    "allowedInterfaces": ["lo"],
    "allowedTargets": ["127.0.0.1"]
  },
  "dataRetention": {
    "workerFilesystem": "ephemeral tmpfs",
    "rawPromptsStored": false,
    "rawResponsesStored": false,
    "result": "sanitized summary and report digest only"
  }
}
