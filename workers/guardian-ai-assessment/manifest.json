    "sampleCount": 144,
    "samplesPerSplit": 72,
    "seedsPerSplit": 4,
    "maxRuntimeSeconds": 15,
    "concurrency": 1,
    "samplesPerScenarioAndSplit": 24,
    "attackAndBenignCasesPerScenarioAndSplit": 12,
    "toolExecution": "in-memory instrumented fake tools only",
    "externalCalls": 0,
    "customerDataAllowed": false,
    "rawPromptsStored": false,
    "rawResponsesStored": false,
    "evidence": "safe tool-call metadata and deterministic SHA-256 digests",
    "interpretation": "fixture-oracle conformance only; not general model accuracy or a security guarantee",
    "importedAgentDojoCodeOrDataset": false
  },
  "detectorCorpus": {
    "schemaVersion": "guardian-ai-detector-corpus-v1",
    "sampleCount": 128,
    "datasets": [
      {
        "id": "attack_success",
        "samplesPerSplit": 32,
        "positiveSupportPerSplit": 16,
        "negativeSupportPerSplit": 16
      },
      {
        "id": "canary_propagation",
        "samplesPerSplit": 32,
        "positiveSupportPerSplit": 16,
        "negativeSupportPerSplit": 16
      }
    ],
    "splits": ["calibration", "holdout"],
    "languages": ["en", "es"],
    "target": "synthetic deterministic local response fixtures",
