{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./rls-catalog-audit": "./src/rls-catalog-audit.ts",
    "./rls-catalog-contract": "./src/rls-catalog-contract.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "apply-rls-policies:dev": "node ./scripts/apply-rls-policies.mjs",
    "harden-runtime-role:dev": "node ./scripts/bootstrap-runtime-role.mjs harden",
    "verify-runtime-role:dev": "node ./scripts/bootstrap-runtime-role.mjs verify",
    "grant-runtime-role:dev": "node ./scripts/bootstrap-runtime-role.mjs grant",
    "configure-runtime-login:dev": "node ./scripts/bootstrap-runtime-role.mjs configure-login"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.1",
    "pgsql-ast-parser": "12.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
